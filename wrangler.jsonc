{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blur",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-18",
  "dev": {
    "ip": "127.0.0.1",
    "port": 18788,
    "inspector_port": 19333
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "blur",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
