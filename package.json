{
  "name": "blur",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node scripts/unit-tests.js && node scripts/verify-e2e.js && node --test scripts/backend-tests.js",
    "test:backend": "node --test scripts/backend-tests.js",
    "test:runtime": "node scripts/runtime-tests.js",
    "dev:full": "wrangler pages dev dist --ip 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply blur --local",
    "db:migrate:remote": "wrangler d1 migrations apply blur --remote",
    "deploy": "wrangler pages deploy dist",
    "audit:balance": "node scripts/balance-audit.js --trials 5000",
    "audit:exposure": "node scripts/analyze-exposure.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10",
    "wrangler": "^4.151.1"
  }
}
